# Copiar a /opt/campo/.env en el VPS (chmod 600). Nunca al repo.
PUBLIC_URL=https://campo.nimbodata.com
ADMIN_EMAILS=sebadeina@gmail.com,sebadeina1@gmail.com

# Google Cloud Console → Credentials → OAuth client (Web).
# Redirect URI: https://campo.nimbodata.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mails de bienvenida y recuperación de contraseña.
RESEND_API_KEY=
RESEND_FROM=

# Parámetros de hash de Firebase Auth (auth-hash-config.json del backup).
# Sin esto, las contraseñas migradas de Firebase no validan.
FIREBASE_SCRYPT_SIGNER_KEY=
FIREBASE_SCRYPT_SALT_SEPARATOR=
FIREBASE_SCRYPT_ROUNDS=8
FIREBASE_SCRYPT_MEM_COST=14
